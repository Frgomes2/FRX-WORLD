# Banco PostgreSQL local (docker compose na raiz do FRX-WORLD sobe um igual a este)
DATABASE_URL="postgresql://frx:frx@localhost:5432/frxworld"

# Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_TRUST_HOST=true

# Admin inicial (usado só pelo comando npm run db:seed)
ADMIN_EMAIL="admin@frxworld.local"
ADMIN_SENHA="troque-esta-senha"
ADMIN_NOME="Flavio"

# Token que o servidor Minecraft usa para falar com a API do painel
SERVIDOR_TOKEN="troque-por-um-token-longo"

# Controle do servidor pelo painel (opcionais)
# SERVIDOR_DIR="../server"
# JAVA17_HOME="C:\Program Files\Eclipse Adoptium\jdk-17.0.21.9-hotspot"
