// FRX-WORLD — banco do painel
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senhaHash String
  criadoEm  DateTime @default(now())
}

model Convite {
  id        String    @id @default(cuid())
  codigo    String    @unique
  nota      String?
  revogado  Boolean   @default(false)
  criadoEm  DateTime  @default(now())
  usadoEm   DateTime?
  jogador   Jogador?  @relation(fields: [jogadorId], references: [id])
  jogadorId String?
}

model Jogador {
  id          String    @id @default(cuid())
  uuid        String    @unique
  nick        String
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  ultimoLogin DateTime?
  nivel       Int       @default(1)
  xp          Int       @default(0)
  rank        String    @default("F")
  mortes      Int       @default(0)
  classe      String    @default("")
  moedas      Int       @default(0) // na bolsa (cobre), enviado pelo servidor
  banco       Int       @default(0) // guardado no banqueiro (cobre)
  titulo      String    @default("") // título escolhido no jogo (/titulo)
  conquistas  Int       @default(0)  // quantas conquistas já tem
  reputacao   Json      @default("{}") // reino → pontos
  campanhas   Json      @default("{}") // reino → {etapa, total, progresso, qtd, nome, etapaTitulo}
  detalhe     Json?     // ficha completa enviada pelo mod (inventário, armadura, habilidades...)
  detalheEm   DateTime?
  online      Boolean   @default(false)
  convites    Convite[]
}

/// Personagens de cada conta (até 3). O Jogador acima guarda os dados do personagem em uso; aqui fica o retrato de todos.
model Personagem {
  id           String   @id @default(cuid())
  uuid         String   // conta (Jogador.uuid)
  vaga         Int      // 1 a 3
  idJogo       String   @default("") // identidade do personagem nos arquivos do mundo (clãs, placar da Torre, temporada)
  nome         String   @default("")
  classe       String   @default("") // nome da classe, como aparece no jogo
  raca         String   @default("")
  nivel        Int      @default(1)
  rank         String   @default("")
  emUso        Boolean  @default(false)
  base         Json?    // retrato dos campos do Jogador (nível, xp, rank, classe, bolsa, título...) na última vez em que esteve em uso
  detalhe      Json?    // ficha completa (inventário, habilidades...) na última vez em que esteve em uso
  detalheEm    DateTime?
  atualizadoEm DateTime @updatedAt

  @@unique([uuid, vaga])
}

/// Configurações do jogo editadas no painel (o servidor lê por /api/servidor/config)
model Configuracao {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @updatedAt
}

/// Missão do quadro da taverna
model Missao {
  id             String   @id @default(cuid())
  titulo         String
  descricao      String   @default("")
  tipo           String   @default("MATAR") // MATAR | COLETAR
  alvo           String   // ex.: minecraft:zombie ou minecraft:iron_ingot
  quantidade     Int      @default(10)
  nivelMin       Int      @default(1)
  rankMin        Int      @default(0) // rank da Guilda exigido: 0 = F ... 6 = S
  recompensaXp   Int      @default(100)
  recompensaMoedas Int    @default(20) // em cobre: 10 = 1 prata, 100 = 1 ouro
  recompensaItens Json    @default("[]") // [{ "item": "minecraft:bread", "qtd": 5 }]
  repetivel      Boolean  @default(false)
  intervaloHoras Int      @default(0)
  preRequisitoId String?
  ativa          Boolean  @default(true)
  ordem          Int      @default(0)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

/// Dungeon: configuração aplicada às criptas do mapa conforme a distância do spawn
model Dungeon {
  id               String   @id @default(cuid())
  nome             String
  descricao        String   @default("")
  distanciaMin     Int      @default(0)
  distanciaMax     Int      @default(100000)
  nivelRecomendado Int      @default(1)
  bossTipo         String   @default("minecraft:zombie")
  bossNome         String   @default("Guardião")
  bossVida         Int      @default(100)
  bossDano         Float    @default(6)
  bossVelocidade   Float    @default(1)
  lacaioTipo       String   @default("minecraft:zombie")
  lacaioQtd        Int      @default(3)
  recompensaXp     Int      @default(500)
  loot             Json     @default("[]") // [{ "item": "minecraft:diamond", "qtd": 1, "chance": 50 }]
  recargaHoras     Int      @default(24)
  andares          Json     @default("[]") // guardiões das camadas 1 e 2
  ativa            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}

/// Chefe de outro mod (Cataclysm, Dungeon Now Loading...) que paga XP/loot do FRX ao morrer.
model ChefeExterno {
  id               String   @id @default(cuid())
  entidade         String   @unique // ex.: cataclysm:ignis
  nome             String
  origem           String   @default("")
  nivelRecomendado Int      @default(1)
  recompensaXp     Int      @default(0)
  loot             Json     @default("[]")
  recargaHoras     Int      @default(0)
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}

/// Estrutura de outro mod: ao entrar, o jogador vê o nome e o nível recomendado.
model EstruturaExterna {
  id               String   @id @default(cuid())
  estrutura        String   @unique // ex.: cataclysm:acropolis
  nome             String
  origem           String   @default("")
  nivelRecomendado Int      @default(1)
  ativa            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}

/// Evento sorteado enquanto o jogador viaja (aba Eventos de estrada).
model EventoEstrada {
  id           String   @id @default(cuid())
  nome         String
  tipo         String   @default("EMBOSCADA") // EMBOSCADA | CHEFE | MERCADOR | TESOURO
  mensagem     String   @default("")
  peso         Int      @default(10)
  nivelMin     Int      @default(1)
  nivelMax     Int      @default(1000)
  mobTipo      String   @default("minecraft:zombie")
  mobQtd       Int      @default(4)
  vida         Int      @default(0) // 0 = vida normal do mob
  dano         Float    @default(0) // 0 = dano normal do mob
  preco        Int      @default(0) // MERCADOR: esmeraldas por item
  recompensaXp Int      @default(0)
  loot         Json     @default("[]")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Habilidade de classe (aba Habilidades). O servidor executa pelo tipo; os números vêm daqui.
model Habilidade {
  id           String   @id @default(cuid())
  codigo       String   @unique // ex.: bola_de_fogo
  nome         String
  descricao    String   @default("")
  classe       String // GUERREIRO | ARQUEIRO | MAGO | CLERIGO | LADINO | ASSASSINO | INVOCADOR | PALADINO
  tipo         String // SKILLSHOT | ALVO | AREA | MOBILIDADE | BUFF | INVOCAR
  elemento     String   @default("FISICO")
  icone        String   @default("minecraft:book")
  custo        Int      @default(20)
  cooldown     Float    @default(5) // segundos
  dano         Float    @default(0) // negativo = cura
  alcance      Float    @default(0)
  raio         Float    @default(0)
  duracao      Float    @default(0) // segundos
  efeito       String   @default("") // efeito de poção, ou mob para INVOCAR
  potencia     Int      @default(0) // nível do efeito, ou quantidade para INVOCAR
  nivelReq     Int      @default(1)
  ultimate     Boolean  @default(false)
  aprendizado  String   @default("NIVEL") // NIVEL | ITEM (Tomo Arcano)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Item das lojas das capitais (aba Economia). MERCADOR = jogador compra; COMPRADOR = jogador vende.
model ItemLoja {
  id           String   @id @default(cuid())
  loja         String   // MERCADOR | COMPRADOR
  item         String   // ex.: minecraft:bread
  qtd          Int      @default(1)
  preco        Int      // em cobre: 10 = 1 prata, 100 = 1 ouro
  nivelMin     Int      @default(1) // mercador: só aparece para jogadores deste nível para cima
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Masmorra fixa (estrutura de outro mod colocada uma vez por mundo ao ligar o servidor)
model Masmorra {
  id                String    @id // slug, ex.: dwargon-ferro
  nome              String
  chefe             String    @default("")
  estrutura         String    // ids separados por | (vale a primeira que gerar)
  nivel             Int       @default(0) // nível fixo dos monstros lá dentro (0 = segue a zona)
  x                 Int
  z                 Int
  entradaX          Int?
  entradaY          Int?
  entradaZ          Int?
  ativo             Boolean   @default(true)
  ordem             Int       @default(0)
  refazer           Boolean   @default(false) // colocar de novo no próximo início
  colocadaX         Int?
  colocadaY         Int?
  colocadaZ         Int?
  colocadaEstrutura String?
  colocadaEm        DateTime?
  atualizadoEm      DateTime  @updatedAt
}

/// Skin personalizada de um tipo de NPC (aba NPCs). chave: "papel:<papel>" ou "reino:<reino>:<papel>"
model NpcSkin {
  chave        String   @id
  slim         Boolean  @default(false)
  png          Bytes
  atualizadoEm DateTime @updatedAt
}

// Códex de Armas: armas únicas criadas no painel (só saem do ferreiro ou de missão)
model ArmaCodex {
  id            String   @id @default(cuid())
  codigo        String   @unique // slug, ex.: lamina_do_crepusculo; na missão vira "codex:lamina_do_crepusculo"
  nome          String
  descricao     String   @default("")
  itemBase      String   // item que dá o comportamento (espada, machado, arco...), ex.: minecraft:netherite_sword
  rank          Int      @default(0) // rank da Guilda para usar: 0 = F ... 6 = S
  raridade      Int      @default(0) // 0 Comum ... 4 Lendário
  dano          Float    @default(0) // dano (ou armadura) extra fixo
  limite        Int      @default(0) // total que pode existir no mundo (0 = sem limite)
  ferreiro      Boolean  @default(true) // à venda no ferreiro/armeiro
  preco         Int      @default(0) // em cobre
  nivelMin      Int      @default(1) // nível do jogador para aparecer na loja
  evolui        Boolean  @default(false) // vinculada ao dono e cresce com o nível dele
  danoPorNivel  Float    @default(0)
  umaPorJogador Boolean  @default(true)
  encantos      String   @default("") // "minecraft:sharpness*3, minecraft:unbreaking*2"
  textura       String   @default("") // PNG em base64 (16x16 ou 32x32); vazio = aparência do item base
  modelo        Int      @unique @default(autoincrement()) // número do CustomModelData no pacote de recursos
  emitidas      Int      @default(0) // quantas já existem (enviado pelo servidor)
  donos         Json     @default("{}") // uuid → nick (enviado pelo servidor)
  inquebravel   Boolean  @default(false) // nunca perde durabilidade
  nivelUso      Boolean  @default(false) // ganha nível com o uso (dano em monstros; armadura: dano recebido)
  nivelUsoMax   Int      @default(0) // maior nível de uso já alcançado por uma unidade (enviado pelo servidor)
  primeiroNome  String?  // personagem que recebeu a primeira unidade (mural de armas do site)
  primeiroEm    DateTime?
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

/// Códex de Criaturas: chefes e monstros próprios do servidor (aba Códex de Criaturas).
model CriaturaCodex {
  id           String   @id @default(cuid())
  codigo       String   @unique // slug curto (até 30), ex.: rei_goblin
  nome         String
  descricao    String   @default("")
  tipo         String   @default("chefe") // "chefe" (barra de vida e golpes) ou "monstro" (aparece no meio dos comuns)
  entidade     String   // criatura base: dá o corpo, o jeito de andar e de bater, ex.: minecraft:zombie
  rankMin      Int      @default(0) // 0 = F ... 6 = S: ranks dos lugares em que aparece
  rankMax      Int      @default(6)
  vida         Float    @default(1) // multiplicador por cima da vida que o lugar já dá
  dano         Float    @default(1)
  velocidade   Float    @default(1)
  golpes       String   @default("") // chefes: "ONDA,SALTO,FURIA"
  lacaio       String   @default("") // criatura que o chefe chama no golpe INVOCAR
  locais       String   @default("portal,torre,nether")
  peso         Int      @default(10) // chefe: peso no sorteio; monstro: chance (%) de entrar no lugar de um comum
  xp           Int      @default(0) // XP a mais para quem estiver na luta
  moedas       Int      @default(0) // cobre a mais para quem estiver na luta
  dropItem     String   @default("") // id do item ou "codex:<código da arma>"
  dropChance   Float    @default(0) // %
  dropQtd      Int      @default(1)
  escala       Float    @default(1) // tamanho do desenho (só com skin própria)
  brilho       Boolean  @default(false) // contorno brilhante
  skin         String   @default("") // PNG 64×64 em base64, formato de skin de jogador; vazio = aparência da criatura base
  slim         Boolean  @default(false)
  derrotas     Int      @default(0) // quantas vezes foi derrotado (enviado pelo servidor)
  primeiroNome String   @default("") // personagem que derrotou pela primeira vez (vazio = antes de existir o registro)
  primeiroEm   DateTime?
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Disco de música vendido pelo Mercador de Discos. O áudio (.ogg) fica em painel/dados/discos/<codigo>.ogg, fora do banco e do git.
model Disco {
  id           String   @id @default(cuid())
  codigo       String   @unique // slug curto, vira o nome do som: frxworld:disco.<codigo>
  nome         String
  artista      String   @default("")
  estilo       String   @default("") // estilo de música (Rock, Sertanejo, Trilha sonora...): vira filtro na loja
  descricao    String   @default("")
  preco        Int      @default(100) // em cobre
  rankMin      Int      @default(0) // rank da Guilda para comprar: 0 = F ... 6 = S
  limite       Int      @default(0) // quantas unidades podem existir no mundo (0 = sem limite)
  emitidas     Int      @default(0) // quantas já foram vendidas (o servidor informa)
  arte         Int      @default(1) // aparência pronta (1 a 16), usada quando não há desenho próprio
  textura      String   @default("") // desenho próprio: PNG 16x16 ou 32x32 em base64 ("" = usa a aparência pronta)
  modelo       Int      @unique @default(autoincrement()) // CustomModelData do desenho próprio: 1000 + modelo
  duracao      Int      @default(0) // segundos, lidos do arquivo
  canais       Int      @default(0) // 1 = mono (diminui com a distância), 2 = estéreo
  tamanho      Int      @default(0) // bytes do arquivo
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Mural dos Primeiros (site público): o primeiro personagem a alcançar cada marco. chave = "rank:S", "nivel:50", "torre:100"...
model Feito {
  chave  String   @id
  nome   String   @default("") // nome do personagem ("" = marco que mais de um já tinha quando o mural foi criado)
  conta  String   @default("") // nick da conta (para a skin e para abrir a ficha)
  vaga   Int      @default(0)
  antigo Boolean  @default(false) // alcançado antes de o mural existir: a data não é conhecida
  quando DateTime @default(now())
}

// Conta do jogador no site (/conta). A senha nasce no primeiro acesso, com o código de 6 dígitos mostrado dentro do jogo.
model ContaSite {
  uuid       String    @id // Jogador.uuid
  senha      String    @default("") // bcrypt ("" = ainda não criou senha)
  codigo     String    @default("") // sha256 do código do jogo ("" = nenhum válido)
  codigoAte  DateTime?
  erros      Int       @default(0) // tentativas erradas seguidas
  travadaAte DateTime?
  criadoEm   DateTime  @default(now())
}

model SessaoSite {
  id       String   @id // sha256 do valor do cookie
  uuid     String
  expira   DateTime
  criadoEm DateTime @default(now())

  @@index([uuid])
}

// Crônicas do mundo: acontecimentos guardados (subiu de nível, mudou de rank, recorde na Torre, criatura descoberta, primeiro do servidor).
// Alimentam o feed, o jornal e o histórico de cada personagem no site. chave única evita registrar o mesmo marco duas vezes.
model Cronica {
  id       String   @id @default(cuid())
  chave    String?  @unique
  tipo     String   // nivel | rank | conquista | torre | descoberta | primeiro
  icone    String   @default("")
  texto    String   // frase pronta, sem o nome ("subiu para o nível 12")
  nome     String   @default("") // personagem ("" = acontecimento do mundo)
  conta    String   @default("") // nick da conta (skin e ficha)
  vaga     Int      @default(0)
  destaque Boolean  @default(false) // vira manchete no jornal
  semente  Boolean  @default(false) // já era verdade quando as crônicas começaram: fica guardado só para não repetir, não aparece
  quando   DateTime @default(now())

  @@index([quando])
  @@index([conta, vaga])
}

// Foto diária do ranking de nível, para mostrar quem subiu ou caiu e quanto cada um evoluiu na semana.
model FotoRanking {
  dia     String // AAAA-MM-DD (horário de Brasília)
  conta   String
  vaga    Int
  nivel   Int
  posicao Int

  @@id([dia, conta, vaga])
}

/// Expedição às Terras Inexploradas (uma área nova a cada troca). tipo/nome/descricao/modificadores/regras ficam prontos para expedições especiais.
model Expedicao {
  numero        Int       @id
  tipo          String    @default("normal")
  nome          String    @default("")
  descricao     String    @default("")
  modificadores Json      @default("{}")
  regras        Json      @default("{}")
  inicio        DateTime
  proxima       DateTime  // troca prevista
  fim           DateTime? // quando terminou (null = em andamento)
  tamanho       Int       @default(2000)
  versao        String    @default("")
  ativa         Boolean   @default(true)
  estruturas    Int       @default(0)      // estruturas diferentes descobertas na expedição
  agora         Json      @default("[]")   // nicks dentro dela agora
  atualizadaEm  DateTime  @updatedAt
  participacoes ParticipacaoExpedicao[]
}

/// O que cada conta fez numa expedição (uuid = conta do Minecraft, a mesma do Jogador).
model ParticipacaoExpedicao {
  id         String    @id @default(cuid())
  numero     Int
  expedicao  Expedicao @relation(fields: [numero], references: [numero], onDelete: Cascade)
  uuid       String
  nick       String
  primeira   DateTime
  ultima     DateTime
  tempoSeg   Int       @default(0)
  chunks     Int       @default(0) // pedaços de terreno (16×16) diferentes visitados
  mortes     Int       @default(0)
  chefes     Int       @default(0)
  estruturas Int       @default(0)
  tesouros   Int       @default(0)

  @@unique([numero, uuid])
  @@index([uuid])
}
